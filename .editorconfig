# EditorConfig - helps maintain consistent coding styles

root = true

# All files
[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown files
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Disable syntax checking in documentation
[ARCHITECTURE.md]
# This file contains pseudocode and examples, not actual code
